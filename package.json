{
  "name": "qrdx-monorepo",
  "version": "0.0.2",
  "scripts": {
    "build": "turbo build",
    "build:qrdx": "turbo build --filter=qrdx",
    "dev": "turbo dev --filter=!./plugins/*",
    "check": "npx ultracite@latest check",
    "fix": "npx ultracite@latest fix",
    "test": "turbo test",
    "typecheck": "turbo typecheck --filter=!@repo/typescript-config",
    "typecheck:docs": "pnpm --filter docs exec tsc --noEmit",
    "lint:ci": "./apps/docs/node_modules/.bin/biome ci .",
    "prepush": "pnpm --filter qrdx build:inplace && pnpm typecheck && pnpm typecheck:docs && pnpm lint:ci && pnpm test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "npx npm-check-updates --deep -u -x recharts && pnpm install",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/design-system",
    "db:migrate": "cd packages/database && npx drizzle-kit migrate",
    "db:generate": "cd packages/database && npx drizzle-kit generate",
    "db:push": "cd packages/database && npx drizzle-kit push",
    "db:pull": "cd packages/database && npx drizzle-kit pull",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "clean": "git clean -xdf node_modules",
    "raycast:publish": "cd plugins/raycast && npx @raycast/api@latest publish",
    "raycast:dev": "cd plugins/raycast && pnpm dev",
    "raycast:build": "cd plugins/raycast && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.1.0",
    "husky": "9.1.7",
    "knip": "^5.74.0",
    "tsup": "^8.5.1",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3",
    "ultracite": "7.1.2"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "parse5": "^7.2.1",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": "^7.29.4",
      "@isaacs/brace-expansion@<5.0.1": "^5.0.1",
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "body-parser@<1.20.9": "^1.20.9",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "brace-expansion@>=5.0.0 <5.0.11": "^5.0.11",
      "browserslist@<4.28.7": "^4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "defu@<6.1.5": "^6.1.5",
      "dompurify@>=3.0.0 <3.4.17": "^3.4.17",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "image-size@>=2.0.0 <2.0.3": "^2.0.3",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "jspdf@<4.2.1": "^4.2.1",
      "launch-editor@<2.14.2": "^2.14.2",
      "lodash-es@<4.18.0": "^4.18.0",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "path-to-regexp@<0.1.13": "^0.1.13",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "preact@>=10.28.0 <10.28.2": "^10.28.2",
      "proxy-addr@<2.0.8": "^2.0.8",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "sharp@<0.35.5": "^0.35.5",
      "shell-quote@<1.9.0": "^1.9.0",
      "smol-toml@<1.7.1": "^1.7.1",
      "source-map-js@<1.2.2": "^1.2.2",
      "svgo@>=3.0.0 <3.3.5": "^3.3.5",
      "svgo@>=4.0.0 <4.1.0": "^4.1.0",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "websocket-driver@<0.7.5": "^0.7.5",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "zod@>=4.0.0 <4.6.6": "^4.6.7"
    }
  },
  "type": "module"
}
