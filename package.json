{
  "name": "qrdx-monorepo",
  "version": "0.0.2",
  "scripts": {
    "build": "turbo build",
    "build:qrdx": "turbo build --filter=qrdx",
    "dev": "turbo dev --filter=!./plugins/*",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo test",
    "typecheck": "turbo typecheck --filter=!@repo/typescript-config",
    "typecheck:docs": "cd apps/docs && bun x tsc --noEmit",
    "typegen:docs": "node scripts/typegen-docs.mjs",
    "lint:ci": "ultracite check",
    "prepush": "bun run --filter qrdx build:inplace && bun run typecheck && bun run typegen:docs && bun run typecheck:docs && bun run --filter docs i18n:check && bun run lint:ci && bun run --filter @qrdx/cli build && bun run test",
    "prepush:quick": "bun run --filter qrdx build:inplace && bun run typecheck && bun run typegen:docs && bun run typecheck:docs && bun run --filter docs i18n:check && bun run lint:ci && bun run --filter @qrdx/cli build && TURBO_SCM_BASE=${TURBO_SCM_BASE:-origin/staging} turbo test --affected --only --concurrency=2",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "bunx npm-check-updates --deep -u -x recharts && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/design-system",
    "db:migrate": "cd packages/database && bun x drizzle-kit migrate",
    "db:generate": "cd packages/database && bun x drizzle-kit generate",
    "db:push": "cd packages/database && bun x drizzle-kit push",
    "db:pull": "cd packages/database && bun x drizzle-kit pull",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "clean": "git clean -xdf node_modules",
    "raycast:publish": "cd plugins/raycast && bunx @raycast/api@latest publish",
    "raycast:dev": "cd plugins/raycast && bun run dev",
    "raycast:build": "cd plugins/raycast && bun run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "husky": "9.1.7",
    "knip": "^6.44.1",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "ultracite": "8.1.1"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "jspdf@<4.2.1": "^4.2.1",
    "sharp@<0.35.5": "^0.35.5",
    "rehype-katex>katex": "^0.19.1",
    "@babel/core@<=7.29.0": "^7.29.6",
    "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
    "fflate@>=0.4.5 <0.4.9": "^0.4.9",
    "katex@>=0.11.0 <0.18.2": "^0.18.2",
    "postcss-selector-parser@<6.1.5": "^6.1.5",
    "postcss-selector-parser@>=7.0.0 <7.1.6": "^7.1.6",
    "uuid@<11.1.1": "^11.1.1",
    "@ts-morph/common>minimatch": "^11.0.1",
    "@typescript-eslint/typescript-estree>minimatch": "^11.0.1",
    "@eslint/config-array>minimatch": "^11.0.1",
    "eslint>minimatch": "^11.0.1",
    "@esbuild-kit/core-utils>esbuild": "^0.25.0",
    "use-intl": "4.14.9",
    "icu-minify": "4.14.9"
  },
  "trustedDependencies": [],
  "type": "module"
}
