{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/vitest",
    "ultracite/biome/drizzle"
  ],
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off",
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noRedundantUseStrict": "off",
        // `== null` is the codebase's deliberate null-or-undefined check.
        "noEqualsToNull": "off",
        // Flags defensive checks on casted, untrusted data (API bodies, prefs).
        "noUnnecessaryConditions": "off",
        // The flagged conditions are booleans and strings, which React renders as nothing.
        "noLeakedRender": "off",
        // Mostly parameters and memo() function names that reuse an outer name on purpose.
        "noShadow": "off",
        // Plugins and the app target current Chromium; these features are progressive.
        "useBaseline": "off",
        // Shared assertion helpers (expectScans, failsWith…) call expect() outside it()/test().
        "noMisplacedAssertion": "off",
        // Tests that assert through those helpers have no expect() of their own.
        "useExpect": "off",
        // Table-driven tests check some rows only (`if (version < 40) expect(…)`).
        "noConditionalExpect": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "noNamespaceImport": "off",
        "noImgElement": "off",
        "noBarrelFile": "off",
        "useTopLevelRegex": "off",
        "noDynamicNamespaceImportAccess": "off",
        // Inline JSX handlers are the React style used throughout.
        "noJsxPropsBind": "off",
        // Sequential awaits are deliberate: pagination, rate-limited APIs, try-in-order.
        "noAwaitInLoops": "off"
      },
      "style": {
        "noMagicNumbers": "off",
        "noParameterAssign": "off",
        "noNestedTernary": "off",
        "useBlockStatements": "off",
        "noNonNullAssertion": "off",
        // `i++` loops are idiomatic in the QR matrix and raster code.
        "noIncrementDecrement": "off",
        // A blanket `u` flag changes regex semantics; not worth a blind rewrite.
        "useUnicodeRegex": "off",
        // Positional groups are used for short, local matches.
        "useNamedCaptureGroup": "off",
        // Plain property access is the established style.
        "useDestructuring": "off",
        // Interfaces mix method and property signatures by intent.
        "useConsistentMethodSignatures": "off",
        // Some class methods implement an interface and don't need `this`.
        "useThisInClassMethods": "off",
        // Rethrows map low-level failures to user-facing messages on purpose.
        "useErrorCause": "off",
        // getElementById is the clearer lookup for a known id.
        "useDomQuerySelector": "off"
      },
      "correctness": {
        "useImageSize": "off",
        "noGlobalDirnameFilename": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        // Keys, members, attributes and CSS properties are grouped by meaning, not alphabet.
        "useSortedKeys": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedAttributes": "off",
        "useSortedProperties": "off",
        // Keeps package.json in its hand-ordered layout (scripts in run order).
        "useSortedPackageJson": "off"
      }
    }
  },
  "tailwind": {
    // Theme tokens (text-muted-foreground…) so useTailwindSortedClasses orders them like Tailwind does.
    "stylesheet": "./packages/design-system/styles/globals.css"
  },
  "yaml": {
    // Biome 2.6 formats YAML; keep flow sequences as ["a", "b"], as the files are written.
    "formatter": { "bracketSpacing": false }
  },
  "overrides": [
    {
      // The native scanner reuses the website's packages through Vite aliases
      // (apps/scanner-mobile/vite.config.ts), outside the workspace.
      "includes": ["apps/scanner-mobile/src/**"],
      "linter": {
        "rules": { "correctness": { "noUndeclaredDependencies": "off" } }
      }
    },
    {
      // Installed by the submit_sitemap workflow; eslint comes with @raycast/eslint-config.
      "includes": [".github/scripts/**", "plugins/raycast/eslint.config.js"],
      "linter": {
        "rules": { "correctness": { "noUndeclaredDependencies": "off" } }
      }
    },
    {
      // CSS modules scope with :global(). Ultracite turns Biome's CSS modules
      // parsing off; back on for module files, where the unknown-pseudo-class
      // rule still reads :global() as a typo.
      "includes": ["**/*.module.css"],
      "css": { "parser": { "cssModules": true } },
      "linter": {
        "rules": { "correctness": { "noUnknownPseudoClass": "off" } }
      }
    },
    {
      // Two vendored @layer base blocks (shadcn/ui, next-forge) both style * and body.
      "includes": ["packages/design-system/styles/globals.css"],
      "linter": {
        "rules": { "suspicious": { "noDuplicateSelectors": "off" } }
      }
    }
  ],
  "files": {
    "includes": [
      "**/*",
      "!packages/qrdx/src/codegen.ts",
      "!packages/cli/src/lib/codegen.ts",
      // Sample CLI output, not source
      "!packages/cli/qr.svg",
      // Byte-exact SVG test inputs
      "!packages/qrdx/tests/fixtures",
      "!packages/design-system/components/ui",
      "!packages/design-system/lib",
      "!packages/design-system/hooks",
      "!plugins/raycast/raycast-env.d.ts",
      // The native scanner's generated Xcode and Gradle projects
      "!apps/scanner-mobile/ios",
      "!apps/scanner-mobile/android",
      // Generated screenshots, E2E results and agent worktrees
      "!.claude/build/shots",
      "!.claude/worktrees"
    ]
  }
}
