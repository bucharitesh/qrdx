# apps/api: health check and a daily keep-alive cron. Self-hosting the web app
# does not need it. Copy to apps/api/.env.local for `pnpm --filter api dev`.

# REQUIRED
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qrdx

# REQUIRED in production: the cron route rejects calls without
# `Authorization: Bearer <CRON_SECRET>`. Generate with: openssl rand -hex 32
# CRON_SECRET=

# OPTIONAL: this service's own public URL
# NEXT_PUBLIC_API_URL=http://localhost:3001
