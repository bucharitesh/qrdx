# QRdx environment variables
#
# Where this file goes (paths from the repository root):
#   - Web app (bun run dev / bun run build):  cp apps/app/.env.example apps/app/.env.local
#     The database scripts (bun run db:push and the other db:* scripts) read
#     DATABASE_URL from that same file, so it's the only env file you need.
#   - Docker Compose:                         cp apps/app/.env.example .env
#
# Only the three REQUIRED values are needed to boot. Everything else is
# OPTIONAL and commented out, and leaving one out switches off only its own
# feature. An empty value counts as unset. apps/app/env.ts checks every value
# when the app starts (next dev, next build, a production server): a missing
# required value, or one that's set but invalid (a URL that isn't one, a key
# that's too short), stops it with the variable's name.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# rebuild (or rebuild the Docker image) after changing them.
#
# Set by the platform, don't set these yourself: NODE_ENV, NEXT_RUNTIME, VERCEL_*.
# Self-hosting guide: https://qrdx.dev/docs/self-hosting

# ─── Core (REQUIRED) ──────────────────────────────────────────────────────────

# Public URL of the web app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection string. A Neon database (https://neon.tech) works as is.
# For plain Postgres, see DATABASE_HTTP_ENDPOINT below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qrdx

# Signs sessions and cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ─── Core (OPTIONAL) ──────────────────────────────────────────────────────────

# Public URL Better Auth uses for OAuth callbacks. Recommended in production;
# use the same value as NEXT_PUBLIC_APP_URL.
# BETTER_AUTH_URL=http://localhost:3000

# Only for plain (non-Neon) Postgres. The app uses Neon's serverless HTTP driver,
# so plain Postgres has to sit behind a Neon-compatible HTTP proxy (docker-compose.yml
# runs one and sets this for you). Running the proxy locally on port 4444:
# DATABASE_HTTP_ENDPOINT=http://localhost:4444/sql

# ─── Sign-in: GitHub / Google OAuth ───────────────────────────────────────────
# Sign-in is OAuth-only, so configure at least one provider to create accounts.

# https://github.com/settings/developers → New OAuth App
# Callback URL: <app url>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# https://console.cloud.google.com/apis/credentials → OAuth client ID (Web)
# Redirect URI: <app url>/api/auth/callback/google
# Also used by the Google Drive integration.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Workspace single sign-on (QRdx commercial license) ───────────────────────
# Workspace SSO (OIDC and SAML, on the Business plan) is in the ee/ folders
# under the QRdx commercial license, not the AGPL. Production use needs a written
# agreement with QRdx. Any non-empty key turns it on;
# without it SSO stays off: its sign-in routes aren't registered and the app
# doesn't offer it. Two-step verification and passkeys don't need a key.
# QRDX_EE_LICENSE=

# ─── Admin panel ──────────────────────────────────────────────────────────────

# Admin panel at /admin. Comma-separated, verified account emails; they become
# admins the first time they open /admin.
# ADMIN_EMAILS=you@example.com
# Comma-separated user ids that are always admins
# ADMIN_USER_IDS=

# Search Console numbers on /admin/growth (sc-domain:qrdx.dev): a Google service
# account's JSON key, on one line, with read access to that property. Without
# it the section explains the setup.
# GSC_SERVICE_ACCOUNT_JSON=

# "QRdx in numbers" on the home page: counts of codes, scans, countries and
# accounts read from the database every 12 hours. Off unless set to 1. The
# home page is prerendered, so it's read where the app is built: set it there
# and redeploy (the Docker image doesn't pass it to its build, so it stays off
# in Docker). Admins can preview the real numbers at /admin/numbers either way.
# QRDX_HOME_NUMBERS=1

# ─── AI themes, prompt enhancement and AI QR art (Vercel AI Gateway) ─────────

# Vercel dashboard → AI Gateway → API keys (any Vercel account; the app doesn't
# have to run on Vercel). Usage is billed to that account's AI Gateway credits.
# Without it, AI features return errors; the QR editor itself still works.
# Models per task: apps/app/lib/ai/models.ts
# AI_GATEWAY_API_KEY=

# ─── Payments (Polar) ─────────────────────────────────────────────────────────
# Only needed to sell the Pro and Business plans. Uses the Polar sandbox unless NODE_ENV=production.

# https://polar.sh → Settings → Developers → access token
# POLAR_ACCESS_TOKEN=
# Webhook endpoint: <app url>/api/webhook/polar
# POLAR_WEBHOOK_SECRET=
# Product IDs of the monthly and yearly Pro plans
# NEXT_PUBLIC_QRDX_PRO_MONTHLY_PRODUCT_ID=
# NEXT_PUBLIC_QRDX_PRO_YEARLY_PRODUCT_ID=
# Product IDs of the monthly and yearly Business plans
# NEXT_PUBLIC_QRDX_BUSINESS_MONTHLY_PRODUCT_ID=
# NEXT_PUBLIC_QRDX_BUSINESS_YEARLY_PRODUCT_ID=
# Each product carries a USD and an INR price; checkout charges the currency of
# the visitor's country. Subscriptions to any other product count as Pro.
# Set to 1 once every product above also has a EUR price, to show and charge
# euros in the EU and EEA (off otherwise; they pay in US$)
# NEXT_PUBLIC_QRDX_EUR_PRICES=
# After checkout, buyers are sent back to <NEXT_PUBLIC_APP_URL>/success.

# ─── Affiliate program ────────────────────────────────────────────────────────
# No setting of its own: QRdx's affiliate program runs only where QRdx itself
# runs (an app URL on qrdx.dev, a preview of that project, or local dev), with
# Polar's POLAR_WEBHOOK_SECRET above. A self-hosted copy on its own domain
# never runs it. See packages/availability/rules.ts.

# ─── Integrations ─────────────────────────────────────────────────────────────

# Encrypts stored integration tokens. REQUIRED in production if you enable Dub
# or Google Drive (development falls back to an insecure built-in key).
# At least 32 characters. Generate with: openssl rand -hex 32
# INTEGRATION_ENCRYPTION_KEY=

# Dub.co short links: https://app.dub.co → Settings → OAuth Apps
# DUB_CLIENT_ID=
# DUB_CLIENT_SECRET=
# DUB_REDIRECT_URI=http://localhost:3000/api/integrations/dub/callback

# Short links and file pickers. Each is optional: without its values the
# integration shows "Not configured". OAuth callbacks are
# <app url>/api/integrations/<slug>/callback (slugs: bitly, dropbox, onedrive,
# box, notion). Rebrandly and Short.io need nothing here: people paste their
# own API key. Setup steps: .claude/build/INTEGRATIONS-SETUP.md
# Bitly (optional: people can also paste a generic access token)
# BITLY_CLIENT_ID=
# BITLY_CLIENT_SECRET=
# Dropbox: https://www.dropbox.com/developers/apps
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# OneDrive / SharePoint: Microsoft Entra admin center → App registrations
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Box: https://app.box.com/developers/console
# BOX_CLIENT_ID=
# BOX_CLIENT_SECRET=
# Notion (public integration): https://www.notion.so/profile/integrations
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Google Drive: uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback

# Content sources and data out. Each is optional ("Not configured" without
# it). Callbacks: <app url>/api/integrations/<slug>/callback (slugs: calendly,
# google-sheets, slack, hubspot, mailchimp). Stripe, Cal.com and Shopify need
# nothing here: people paste their own key. Google Sheets uses
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above (add its callback to that
# client). Setup steps: .claude/build/INTEGRATIONS-SETUP.md
# Calendly: https://developer.calendly.com → My apps
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
# Slack ("Add to Slack", incoming-webhook scope): https://api.slack.com/apps
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# QRdx bot for Slack (/qr, mentions, DMs): the same app's Signing Secret (plugins/slack/README.md)
# SLACK_SIGNING_SECRET=
# HubSpot: https://developers.hubspot.com → Apps
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# Mailchimp: https://admin.mailchimp.com/account/oauth2/
# MAILCHIMP_CLIENT_ID=
# MAILCHIMP_CLIENT_SECRET=
# Discord bot (/qr and "Make QR code"): app id and public key, see plugins/discord/README.md
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# Optional pickers: "your channel's videos" (YouTube Data API v3 key) and
# "your playlists" (Spotify app, client credentials). Links work without them.
# YOUTUBE_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Telegram bot: QR codes in Telegram chats (DMs, inline mode, /qr in groups).
# Off unless all three are set. Create the bot with @BotFather, then run
# plugins/telegram/scripts/setup.mjs (steps in plugins/telegram/README.md).
# The bot token from BotFather; never share or log it.
# TELEGRAM_BOT_TOKEN=
# Sent back by Telegram on every webhook call (1-256 of A-Z a-z 0-9 _ -).
# Generate with: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=
# The username you picked in BotFather, without the @ (ends in "bot").
# TELEGRAM_BOT_USERNAME=

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────

# Recommended in production. https://console.upstash.com → Redis → REST API.
# Without a URL and token rate limiting is a no-op (a warning is logged once).
# Client IPs come from x-real-ip / x-forwarded-for, so run behind a reverse
# proxy that sets them.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# The Vercel KV / Upstash integration sets these names instead; they are used
# when the UPSTASH_* values above are unset.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─── Dynamic QR codes ─────────────────────────────────────────────────────────

# Origin for short links (<origin>/q/<slug>). Defaults to the app URL.
# NEXT_PUBLIC_SHORT_LINK_BASE_URL=https://qrdx.dev
# Secret salt for hashing scan visitors (IP + user agent + day; raw IPs are never
# stored). At least 16 characters; defaults to one derived from BETTER_AUTH_SECRET.
# Generate with: openssl rand -hex 32
# SCAN_HASH_SALT=

# ─── One-click DNS setup (Domain Connect) ─────────────────────────────────────
# A "Set up with <your DNS provider>" button for domains waiting for DNS, where
# custom domains work. Needs a Domain Connect template accepted by each DNS
# provider (QRdx's: domain-connect/qrdx.dev.qrdx.json, steps in
# domain-connect/SUBMISSION.md) and the RSA key that signs setup links. Its
# public key must be published as TXT records at _dck1.<provider id>; until it
# matches, no button is shown and the server logs why.
# DOMAIN_CONNECT_PROVIDER_ID=qrdx.dev
# DOMAIN_CONNECT_SERVICE_ID=qrdx
# RSA private key in PEM (2048 bits or more); newlines may be written as \n
# DOMAIN_CONNECT_PRIVATE_KEY=

# ─── Custom domains (Vercel) ──────────────────────────────────────────────────
# Adds customers' domains to this Vercel project through the Vercel API. Unlike
# the platform's VERCEL_* values, you set these yourself. Leave unset when
# self-hosting.

# https://vercel.com/account/tokens
# VERCEL_API_TOKEN=
# Project → Settings → General → Project ID
# VERCEL_PROJECT_ID=
# Only when the project belongs to a Vercel team
# VERCEL_TEAM_ID=

# ─── File storage (Cloudflare R2) ─────────────────────────────────────────────
# File uploads (PDFs, images, ...) are hidden until the first four are set.
# Cloudflare dashboard → R2 → Manage API tokens (Object Read & Write on the bucket)
# Browsers upload straight to the bucket: its CORS policy must allow PUT with a
# Content-Type header from the app origin (JSON policy in /docs/files).

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Public bucket URL (r2.dev or a custom domain) used to serve files. Without it,
# files are served through short-lived presigned URLs.
# R2_PUBLIC_BASE_URL=https://files.example.com

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com/api-keys. Without a key, emails are skipped (and logged)
# and team invites fall back to copyable links.

# RESEND_API_KEY=
# Sender address on a domain verified in Resend
# EMAIL_FROM=QRdx <hello@qrdx.dev>

# ─── Scheduled jobs (webhook retries, weekly digest) ──────────────────────────
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to /api/cron/*
# (apps/app/vercel.json). Self-hosted: call those URLs on a schedule with the
# same header. Without it the cron routes refuse requests in production.
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# ─── Abuse and spam protection ────────────────────────────────────────────────

# Google Web Risk API key for checking destination URLs
# https://console.cloud.google.com/apis/library/webrisk.googleapis.com
# WEB_RISK_API_KEY=
# Cloudflare Turnstile for public forms: https://dash.cloudflare.com → Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Abuse limits, whole numbers above 0 (lib/safety/limits.ts). Unset, each one
# keeps the default shown here, which anyone can read in the source.
# Days an account counts as new (hourly cap, suspicious links held for review)
# SAFETY_YOUNG_ACCOUNT_DAYS=7
# Dynamic codes a new account can create per hour
# SAFETY_YOUNG_ACCOUNT_DYNAMIC_PER_HOUR=30
# Destinations one Web Risk recheck pass looks up again
# SAFETY_RECHECK_BATCH=500

# ─── Content-Security-Policy ──────────────────────────────────────────────────
# Production builds send a Content-Security-Policy on QRdx's own pages. Set
# these where the app is built and where it runs.

# Send the policy as report-only while you check a new setup; violations are
# logged by /api/csp-report
# CSP_REPORT_ONLY=1
# Serving over HTTPS outside Vercel: browsers upgrade any http:// resource
# CSP_HTTPS=1

# ─── Analytics and widgets ────────────────────────────────────────────────────

# Analytics run in production on the NEXT_PUBLIC_APP_URL host only. Locally,
# opt a browser in with localStorage.setItem("qrdx:analytics-debug", "1").

# PostHog product analytics (https://posthog.com), loaded only after the visitor
# allows analytics in the cookie banner. Skipped when the key is unset.
# Project API key (phc_...): PostHog → Project settings → Project API key.
# NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host for server-side events; the browser goes through /ingest.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Umami web analytics (https://umami.is): cookieless, so no consent needed.
# Off when the website id is unset. Website id: Umami → Settings → Websites →
# Edit → Website ID. The script URL defaults to Umami Cloud; set it for a
# self-hosted Umami (https://your-umami.example.com/script.js).
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Featurebase feedback widget, loaded in production only
# NEXT_PUBLIC_FEATUREBASE_APP_ID=

# ─── Docs site extras ─────────────────────────────────────────────────────────

# GitHub token for the star counter in the docs (avoids API rate limits)
# GITHUB_TOKEN=

# The docs site (apps/docs-site), no trailing slash. When set, this app
# proxies /docs and the other docs URLs to it, and the sitemap and llms.txt
# list the docs from its /zone/docs-manifest.json. Leave it unset to serve the
# docs from this app (self-hosting).
# DOCS_ZONE_URL=https://docs.qrdx.dev

# OpenAI plugin directory: the domain-verification token its submission portal
# shows, served as plain text at /.well-known/openai-apps-challenge on every
# host (the portal checks the MCP host). Only the hosted QRdx needs it.
# OPENAI_APPS_CHALLENGE=

# ─── Tooling ──────────────────────────────────────────────────────────────────

# Bundle analyzer: ANALYZE=true bun run build
# ANALYZE=true

# Self-contained server build in .next/standalone (the Dockerfile sets this)
# NEXT_OUTPUT=standalone

# ─── Docker Compose only ──────────────────────────────────────────────────────
# Read by docker-compose.yml, not by the app.

# Password for the Postgres container in docker-compose.yml
# POSTGRES_PASSWORD=postgres
