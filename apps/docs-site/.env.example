# QRdx docs site environment variables (apps/docs-site)
#
#   cp apps/docs-site/.env.example apps/docs-site/.env.local
#
# The docs site is the docs zone of qrdx.dev: the main app (apps/docs)
# proxies /docs and the other docs URLs here once its DOCS_ZONE_URL is set.
# It has no database and no secrets. apps/docs-site/env.ts checks every value
# when it starts (next dev, next build, a production server).
#
# Set by the platform, don't set these yourself: NODE_ENV, NEXT_RUNTIME, VERCEL_*.

# ─── Core (REQUIRED) ──────────────────────────────────────────────────────────

# The site's public URL, no trailing slash: the main app's, because readers
# reach the docs through it (https://qrdx.dev). Canonical links, Open Graph
# URLs and the sitemap entries are written against it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The main app this docs site belongs to, no trailing slash. Builds read its
# /zone/availability.json, so the docs show only what it offers. Required in
# production builds and servers; locally, without it, the docs treat every
# feature that needs setup as unavailable.
MAIN_ZONE_URL=http://localhost:3000

# ─── Optional ─────────────────────────────────────────────────────────────────

# Origin for default short links (falls back to the site URL)
# NEXT_PUBLIC_SHORT_LINK_BASE_URL=https://qrdx.dev

# Public bucket URL or custom domain for served files, as in the main app
# (the Content-Security-Policy allows its origin for images and media)
# R2_PUBLIC_BASE_URL=https://files.example.com

# Content-Security-Policy switches, as in the main app: send the policy
# report-only, and upgrade http:// resources when serving over HTTPS off Vercel
# CSP_REPORT_ONLY=1
# CSP_HTTPS=1

# Analytics, as in the main app (they run in production on the
# NEXT_PUBLIC_APP_URL host only). PostHog loads after the visitor allows
# analytics; Umami is cookieless; Featurebase loads in production only.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# NEXT_PUBLIC_FEATUREBASE_APP_ID=

# GitHub token for the star counter in the docs (avoids API rate limits)
# GITHUB_TOKEN=

# ─── Tooling ──────────────────────────────────────────────────────────────────

# Bundle analyzer: ANALYZE=true bun run build
# ANALYZE=true

# Self-contained server build in .next/standalone
# NEXT_OUTPUT=standalone
