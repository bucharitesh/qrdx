{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["../app/*"],
      "@repo/design-system": ["../../packages/design-system/index.tsx"],
      "@repo/design-system/*": ["../../packages/design-system/*"],
      "next-intl": ["./src/shims/next-intl.ts"],
      "next/link": ["./src/shims/next-link.tsx"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "barcode-detector/ponyfill": [
        "../app/node_modules/barcode-detector/dist/es/ponyfill.d.ts"
      ]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"]
}
