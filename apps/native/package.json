{
  "name": "@qrdx/native",
  "version": "0.1.0",
  "private": true,
  "description": "QRdx Scanner for iOS and Android: the web scanner's UI in Capacitor, with native camera scanning. Not published yet (see README.md).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "messages": "node scripts/messages.mjs",
    "dev": "node scripts/messages.mjs && vite",
    "build": "node scripts/messages.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "sync": "bun run build && cap sync",
    "android:apk": "bun run sync && cd android && ./gradlew assembleDebug",
    "ios:build": "bun run sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath ~/Library/Developer/Xcode/DerivedData/qrdx-scanner build"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "iconsax-reactjs": "0.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "use-intl": "4.14.9"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  },
  "trustedDependencies": []
}
