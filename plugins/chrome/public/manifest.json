{
  "manifest_version": 3,
  "name": "QRdx — QR code for this page",
  "short_name": "QRdx",
  "version": "0.0.1",
  "description": "Styled QR codes for this page, any link, image or selected text. Download PNG or SVG, or copy. Made in your browser.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "QR code for this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "storage"]
}
