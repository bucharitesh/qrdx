{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "**/generated/**",
        "storybook-static/**",
        ".react-email/**",
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["QRDX_FULL_FRAME_SCAN", "QRDX_FRAME_SCAN_DAY"],
      "outputs": []
    },
    "@qrdx/cli#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "app#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/docs/content/**"],
      "env": ["QRDX_FULL_FRAME_SCAN", "QRDX_FRAME_SCAN_DAY"],
      "outputs": []
    },
    "docs#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/package.json",
        "$TURBO_ROOT$/apps/app/messages/*.json",
        "$TURBO_ROOT$/apps/app/scripts/i18n-docs-messages.ts",
        "$TURBO_ROOT$/apps/app/lib/i18n/docs-messages.ts",
        "$TURBO_ROOT$/apps/app/public/openapi.json",
        "$TURBO_ROOT$/apps/app/scripts/openapi/export.ts",
        "$TURBO_ROOT$/apps/app/lib/docs-redirects.ts",
        "$TURBO_ROOT$/apps/app/scripts/facts-snapshot.ts",
        "$TURBO_ROOT$/apps/app/lib/product-facts.ts",
        "$TURBO_ROOT$/apps/app/lib/product-facts-snapshot.ts",
        "$TURBO_ROOT$/apps/app/lib/format-count.ts",
        "$TURBO_ROOT$/apps/app/lib/pricing.ts",
        "$TURBO_ROOT$/apps/app/lib/scan-history.ts",
        "$TURBO_ROOT$/apps/app/lib/affiliates/terms.ts",
        "$TURBO_ROOT$/apps/app/lib/ai/art-models.ts",
        "$TURBO_ROOT$/apps/app/lib/ai/models.ts",
        "$TURBO_ROOT$/apps/app/lib/barcode/formats.ts",
        "$TURBO_ROOT$/apps/app/lib/brand-logos/catalog.generated.ts",
        "$TURBO_ROOT$/apps/app/lib/landing/page-type-ids.ts",
        "$TURBO_ROOT$/apps/app/ee/audit-log/limits.ts",
        "$TURBO_ROOT$/apps/app/types/content-type-ids.ts",
        "$TURBO_ROOT$/apps/app/types/qr-content.ts",
        "$TURBO_ROOT$/apps/app/components/sections/ai-art/preset-meta.ts"
      ],
      "env": ["MAIN_ZONE_URL", "DOCS_REQUIRE_AVAILABILITY"],
      "outputs": []
    },
    "docs#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/package.json",
        "$TURBO_ROOT$/apps/app/messages/*.json",
        "$TURBO_ROOT$/apps/app/scripts/i18n-docs-messages.ts",
        "$TURBO_ROOT$/apps/app/lib/i18n/docs-messages.ts",
        "$TURBO_ROOT$/apps/app/public/openapi.json",
        "$TURBO_ROOT$/apps/app/scripts/openapi/export.ts",
        "$TURBO_ROOT$/apps/app/lib/docs-redirects.ts",
        "$TURBO_ROOT$/apps/app/scripts/facts-snapshot.ts",
        "$TURBO_ROOT$/apps/app/lib/product-facts.ts",
        "$TURBO_ROOT$/apps/app/lib/product-facts-snapshot.ts",
        "$TURBO_ROOT$/apps/app/lib/format-count.ts",
        "$TURBO_ROOT$/apps/app/lib/pricing.ts",
        "$TURBO_ROOT$/apps/app/lib/scan-history.ts",
        "$TURBO_ROOT$/apps/app/lib/affiliates/terms.ts",
        "$TURBO_ROOT$/apps/app/lib/ai/art-models.ts",
        "$TURBO_ROOT$/apps/app/lib/ai/models.ts",
        "$TURBO_ROOT$/apps/app/lib/barcode/formats.ts",
        "$TURBO_ROOT$/apps/app/lib/brand-logos/catalog.generated.ts",
        "$TURBO_ROOT$/apps/app/lib/landing/page-type-ids.ts",
        "$TURBO_ROOT$/apps/app/ee/audit-log/limits.ts",
        "$TURBO_ROOT$/apps/app/types/content-type-ids.ts",
        "$TURBO_ROOT$/apps/app/types/qr-content.ts",
        "$TURBO_ROOT$/apps/app/components/sections/ai-art/preset-meta.ts"
      ],
      "env": ["MAIN_ZONE_URL", "DOCS_REQUIRE_AVAILABILITY"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "analyze": {
      "dependsOn": ["^analyze"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "translate": {
      "dependsOn": ["^translate"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "remoteCache": {
    "enabled": false
  }
}
