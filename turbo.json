{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "**/generated/**",
        "storybook-static/**",
        ".react-email/**",
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["QRDX_FULL_FRAME_SCAN", "QRDX_FRAME_SCAN_DAY"],
      "outputs": []
    },
    "@qrdx/cli#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "docs-site#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/docs/**",
        "!$TURBO_ROOT$/apps/docs/.next/**",
        "!$TURBO_ROOT$/apps/docs/.source/**",
        "!$TURBO_ROOT$/apps/docs/node_modules/**"
      ],
      "env": ["MAIN_ZONE_URL", "DOCS_REQUIRE_AVAILABILITY"],
      "outputs": []
    },
    "docs-site#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/docs/**",
        "!$TURBO_ROOT$/apps/docs/.next/**",
        "!$TURBO_ROOT$/apps/docs/.source/**",
        "!$TURBO_ROOT$/apps/docs/node_modules/**"
      ],
      "env": ["MAIN_ZONE_URL", "DOCS_REQUIRE_AVAILABILITY"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "analyze": {
      "dependsOn": ["^analyze"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "translate": {
      "dependsOn": ["^translate"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "remoteCache": {
    "enabled": false
  }
}
