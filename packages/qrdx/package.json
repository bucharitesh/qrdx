{
  "name": "qrdx",
  "version": "0.0.47",
  "description": "Customizable QR code generator for React: SVG and canvas rendering, dot and eye patterns, gradients, logos, frames, Logo QR and Image QR art, PNG/SVG/PDF/EPS export, a scan score and QR scanning.",
  "keywords": [
    "qr-code",
    "qrcode",
    "qr-code-generator",
    "react-qr-code",
    "react",
    "svg",
    "typescript",
    "qr-scanner",
    "qr-code-svg",
    "qr-code-logo",
    "eps",
    "pdf"
  ],
  "homepage": "https://qrdx.dev/docs",
  "bugs": {
    "url": "https://github.com/bucharitesh/qrdx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bucharitesh/qrdx.git",
    "directory": "packages/qrdx"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Ritesh Bucha",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:inplace": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "readme": "node scripts/readme-catalogue.mjs",
    "prepublishOnly": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('pnpm/')){console.error('Publish with pnpm publish: it turns workspace: ranges into real versions.');process.exit(1)}\" && pnpm run build && pnpm run test && node scripts/readme-catalogue.mjs --check"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.1.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jspdf": "^3.0.4",
    "next": "16.1.1",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "jspdf": "^2.5.0 || ^3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "jspdf": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
