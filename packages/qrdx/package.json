{
  "name": "qrdx",
  "version": "0.0.49",
  "description": "Customizable QR code generator for React: SVG and canvas rendering, dot and eye patterns, gradients, logos, frames, Logo QR and Image QR art, PNG/JPG/WebP/SVG/PDF/EPS export, a scan score and QR scanning.",
  "keywords": [
    "qr-code",
    "qrcode",
    "qr-code-generator",
    "react-qr-code",
    "react",
    "svg",
    "typescript",
    "qr-scanner",
    "qr-code-svg",
    "qr-code-logo",
    "eps",
    "pdf",
    "webp"
  ],
  "homepage": "https://qrdx.dev/docs",
  "bugs": {
    "url": "https://github.com/bucharitesh/qrdx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bucharitesh/qrdx.git",
    "directory": "packages/qrdx"
  },
  "license": "MIT",
  "author": "Ritesh Bucha",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:inplace": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "readme": "node scripts/readme-catalogue.mjs",
    "prepublishOnly": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('bun/')){console.error('Publish through the Publish workflow, or with bun publish, which replaces workspace ranges with real versions.');process.exit(1)}\" && bun run build && bun run test && node scripts/readme-catalogue.mjs --check"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jspdf": "^4.2.1",
    "next": "16.4.3",
    "react": "^19.3.1",
    "sharp": "0.35.5",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "jspdf": "^2.5.0 || ^3.0.0 || ^4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "jspdf": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
