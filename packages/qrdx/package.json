{
  "name": "qrdx",
  "version": "0.0.51",
  "description": "Customizable QR code generator for React and plain JavaScript: SVG and canvas rendering, dot and eye patterns, gradients, logos, frames, Logo QR and Image QR art, PNG/JPG/WebP/SVG/PDF/EPS export, a scan score and QR scanning.",
  "keywords": [
    "qr-code",
    "qrcode",
    "qr-code-generator",
    "react-qr-code",
    "react",
    "vanilla-js",
    "svg",
    "typescript",
    "qr-scanner",
    "qr-code-svg",
    "qr-code-logo",
    "eps",
    "pdf",
    "webp"
  ],
  "homepage": "https://qrdx.dev/docs",
  "bugs": {
    "url": "https://github.com/bucharitesh/qrdx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bucharitesh/qrdx.git",
    "directory": "packages/qrdx"
  },
  "license": "MIT",
  "author": "Ritesh Bucha",
  "sideEffects": [
    "./dist/element-define.mjs",
    "./dist/element-define.js",
    "./dist/element-define.browser.mjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "unpkg": "./dist/vanilla.browser.mjs",
  "jsdelivr": "./dist/vanilla.browser.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/src/core.d.ts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/src/core.d.ts",
        "default": "./dist/core.js"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/src/vanilla.d.ts",
        "default": "./dist/vanilla.mjs"
      },
      "require": {
        "types": "./dist/src/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/src/element.d.ts",
        "default": "./dist/element.mjs"
      },
      "require": {
        "types": "./dist/src/element.d.ts",
        "default": "./dist/element.js"
      }
    },
    "./element/define": {
      "import": {
        "types": "./dist/src/element-define.d.ts",
        "default": "./dist/element-define.mjs"
      },
      "require": {
        "types": "./dist/src/element-define.d.ts",
        "default": "./dist/element-define.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/src/node.d.ts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/src/node.d.ts",
        "default": "./dist/node.js"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/src/vue.d.ts",
        "default": "./dist/vue.mjs"
      },
      "require": {
        "types": "./dist/src/vue.d.ts",
        "default": "./dist/vue.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/public.d.ts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/public.d.ts",
        "default": "./dist/types/index.js"
      }
    },
    "./package.json": "./package.json",
    "./preact": {
      "import": {
        "types": "./dist/src/preact.d.ts",
        "default": "./dist/preact.mjs"
      },
      "require": {
        "types": "./dist/src/preact.d.ts",
        "default": "./dist/preact.js"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/src/solid.d.ts",
        "default": "./dist/solid.mjs"
      },
      "require": {
        "types": "./dist/src/solid.d.ts",
        "default": "./dist/solid.js"
      }
    }
  },
  "files": [
    "dist",
    "types",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:inplace": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "readme": "node scripts/readme-catalogue.mjs",
    "prepublishOnly": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('bun/')){console.error('Publish through the Publish workflow, or with bun publish, which replaces workspace ranges with real versions.');process.exit(1)}\" && bun run build && bun run test && node scripts/readme-catalogue.mjs --check"
  },
  "dependencies": {
    "csstype": "^3.2.3",
    "jsqr": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "28.1.0",
    "jspdf": "^4.2.1",
    "next": "16.4.3",
    "react": "^19.3.1",
    "sharp": "0.35.5",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.45",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.3",
    "solid-js": "^1.9.19"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jspdf": "^2.5.0 || ^3.0.0 || ^4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "sharp": ">=0.34.0",
    "vue": ">=3.3.0",
    "preact": ">=10.0.0",
    "solid-js": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
