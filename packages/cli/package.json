{
  "name": "@qrdx/cli",
  "version": "0.0.10",
  "description": "QR code generator CLI for developers: styled SVG, PNG, WebP and vector EPS QR codes from the command line",
  "keywords": [
    "qr-code",
    "qrcode",
    "qr-code-generator",
    "cli",
    "svg",
    "png",
    "webp",
    "eps",
    "qr-code-cli"
  ],
  "homepage": "https://qrdx.dev/docs",
  "bugs": {
    "url": "https://github.com/bucharitesh/qrdx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bucharitesh/qrdx.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Ritesh Bucha",
  "type": "module",
  "bin": {
    "qrdx": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "qrdx": "node ./dist/index.js",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('bun/')){console.error('Publish through the Publish workflow, or with bun publish, which replaces workspace ranges with real versions.');process.exit(1)}\" && bun run build && bun run test && node ../qrdx/scripts/readme-catalogue.mjs --check"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1",
    "qrdx": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
