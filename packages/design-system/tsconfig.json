{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    // Node for the OG fonts (og/), Next for its module types (*.module.css)
    "types": ["node", "next"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@repo/*": ["../*"],
      "@repo/design-system/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
